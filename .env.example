# Set exactly one of these -- Sutra auto-detects whichever is present, in
# this priority order, and prints which one it picked at startup:
# GEMINI_API_KEY, DEEPSEEK_API_KEY, QWEN_API_KEY, OPENAI_API_KEY, GROQ_API_KEY.
# None set -> falls back to the offline MockAdapter for the built-in fixtures.
GROQ_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Only needed for --create-pr (demo/run_demo.py --repo ... --create-pr).
# Create one at https://github.com/settings/tokens with 'repo' scope.
# GITHUB_TOKEN=ghp_...
