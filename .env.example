# ==============================================================================
# OFFICIAL HACKATHON EVALUATION CREDENTIAL (HIGHEST PRIORITY)
# The evaluation environment sets: export AI_API_KEY="<PROVIDED_API_KEY>"
# When AI_API_KEY is set, Sutra uses it directly.
# ==============================================================================
AI_API_KEY=

# Optional: Override the model string used with AI_API_KEY.
# Defaults to the value set in harness/config.py (gemini/gemini-3.1-flash-lite).
# Common examples:
#   AI_MODEL=gemini/gemini-3.1-flash-lite
#   AI_MODEL=gpt-4o-mini
#   AI_MODEL=claude-3-5-sonnet-20241022
# AI_MODEL=

# ==============================================================================
# LOCAL DEVELOPMENT FALLBACK CREDENTIALS
# Used only if AI_API_KEY is not set. Sutra auto-detects in this priority order:
# ==============================================================================
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# ==============================================================================
# GITHUB PERSONAL ACCESS TOKEN (FOR AUTOMATED PULL REQUESTS)
# Only needed if you choose Option 2 ("Create PR") in the interactive menu.
# 1. Go to: https://github.com/settings/tokens
# 2. Click "Generate new token" -> select "Generate new token (classic)"
# 3. Under 'Select scopes', CHECK THE BOX FOR: [x] repo (Full control of private repositories)
# 4. Copy the generated token and paste below:
# GITHUB_TOKEN=ghp_...
# ==============================================================================
